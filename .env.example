# SentiLLM Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# NVD API Key (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# GitHub Personal Access Token (https://github.com/settings/tokens)
# Gerekli izinler: repo, write:discussion
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Opsiyonel: RunPod veya yerel LLM için
# LLM_BASE_URL=https://your-runpod-endpoint.com/v1
